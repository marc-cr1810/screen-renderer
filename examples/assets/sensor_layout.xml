<screen>
    <!-- Styles -->
    <style id="header_text" scale="1" />
    <style id="big_value" scale="5" />
    <style id="label" scale="1" />

    <!-- Header -->
    <line x1="0" y1="9" x2="127" y2="9" />
    <text style="header_text" x="2" y="1" text="SENSOR STATUS" />
    
    <!-- Battery Group (Icon + Text) -->
    <group x="105" y="1">
        <bitmap src="icon_battery" x="-12" y="0" />
        <text id="battery" x="0" y="0" text="100%" />
    </group>

    <text id="network" x="75" y="1" text="NET" />
    <bitmap src="icon_arrow_up" x="65" y="1" visible="false" id="upload_icon" />

    <!-- Left Panel: Drone Count -->
    <group x="5" y="12">
        <text style="label" x="0" y="0" text="DETECTED" />
        <!-- Big number -->
        <text id="drone_count" style="big_value" x="6" y="10" text="0" />
        <bitmap src="icon_drone" x="35" y="10" />
    </group>

    <!-- Right Panel: Graphs & Stats -->
    <line x1="64" y1="9" x2="64" y2="54" />
    
    <group x="68" y="12">
        <text style="label" x="0" y="0" text="ACTIVITY" />
        <!-- Graph placeholder container -->
        <rect x="0" y="8" w="56" h="20" fill="false" />
    </group>

    <group x="68" y="44">
        <text style="label" x="0" y="0" text="CPU" />
        <rect id="cpu_bar_frame" x="20" y="0" w="36" h="6" fill="false" />
    </group>

    <!-- Footer -->
    <line x1="0" y1="55" x2="127" y2="55" />
    <text id="coords" x="2" y="57" text="-33.86,151.20" />
    <text id="no_fix" x="100" y="57" text="NO FIX" visible="false" />
</screen>
