<screen>
    <!-- Header -->
    <line x1="0" y1="9" x2="127" y2="9" />
    <text x="2" y="1" text="SENSOR STATUS" />
    <text id="battery" x="105" y="1" text="100%" />
    <text id="network" x="85" y="1" text="NET" />

    <!-- Left Panel: Drone Count -->
    <text x="5" y="12" text="DETECTED" />
    <!-- Big number, simulated by text with high scale -->
    <text id="drone_count" x="11" y="22" text="0" scale="5" />

    <!-- Right Panel: Graphs & Stats -->
    <line x1="64" y1="9" x2="64" y2="54" />
    
    <text x="68" y="12" text="ACTIVITY" />
    <!-- Graph placeholder container -->
    <rect x="68" y="20" w="56" h="20" fill="false" />
    <!-- We will draw the graph manually on top for now, or could extend markup later.
         For this demo, we let the C++ code handle complex dynamic drawing like graphs
         on top of the layout, or we just skip the graph for the markup demo to show
         basic static + text layout capabilities. Let's stick to markup capabilities. -->

    <text x="68" y="44" text="CPU" />
    <rect id="cpu_bar_frame" x="88" y="44" w="36" h="6" fill="false" />
    <!-- Inner bar could be manipulated by width, but our parser doesn't support changing attributes yet.
         So we'll just have the frame. -->

    <!-- Footer -->
    <line x1="0" y1="55" x2="127" y2="55" />
    <text id="coords" x="2" y="57" text="-33.86,151.20" />
    <text id="no_fix" x="100" y="57" text="NO FIX" visible="false" />
</screen>
